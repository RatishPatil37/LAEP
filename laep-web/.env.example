# LAEP Planetary Mission Platform — Environment Configuration Template
# Copy this file to .env and configure your keys

# Google Gemini API Key (Get yours free at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# Public API URL (Leave empty for local dev proxy to http://localhost:8000)
VITE_API_URL=

# Lunar Explorer: browser-public, URL-scoped read-only ion token. Never use a secret/server token.
# Add Cesium Moon to YOUR ion account, then copy its asset ID here.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_MOON_ASSET_ID=
# Alternative: your own CORS-enabled lunar 3D Tiles URL (Moon-fixed coordinates).
VITE_LUNAR_TILESET_URL=
